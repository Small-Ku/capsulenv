@{
    # This file is merged over config/capsulenv.psd1.
    # Copy it to capsulenv.local.psd1; the local file is git-ignored.

    Scoop = @{
        # Root = 'D:\portable\scoop'
        # GlobalRoot = 'D:\portable\scoop-global'
        # RehydrateOnRelocation = $false

        # Only replay hooks that are safe and needed after relocation.
        # pre_install is deliberately not enabled by default because many
        # manifests treat it as a one-shot transformation.
        # ReplayHooks replaces the default allow-list as one unit.
        # Use @{} to disable automatic hook replay entirely.
        # Keys are installed Scoop app selectors. Use user/<app> or
        # global/<app> when a rule must target one scope exactly.
        # ReplayHooks = @{
        #     firefox = @('post_install')
        #     'global/zen-browser' = @('post_install')
        # }


        # RelocationRepairs also replaces the default allow-list as one unit.
        # Use @{} to disable all persisted text path repairs.
        # Keys accept the same <app> / user/<app> / global/<app> selector.
        # RelocationRepairs = @{
        #     'user/some-app' = @(
        #         @{
        #             Path = 'config\settings.json'
        #             Format = 'json' # text | json
        #             Processes = @('some-app')
        #             MaxBytes = 4194304
        #             Required = $false
        #         }
        #     )
        # }
    }

    Bitwarden = @{
        StartOnEnter = $false
        # Any compatible installed Scoop app selector.
        # App = 'global/my-bitwarden'
        # ShortcutName = 'Bitwarden'
        # StatePath = 'bitwarden-appdata\data.json'
        # always | never | remember-until-lock
        Authorization = 'always'
    }

    SingBox = @{
        # Any compatible installed Scoop app selector. Empty/missing persisted
        # config makes AutoConnect a no-op rather than a download/provision step.
        # App = 'global/my-sing-box'
        # BinName = 'sing-box'
        # ConfigPath = 'config.json'
        # ConfigDirectory = ''
        # AutoConnect = $true
    }

    UserIntegration = @{
        # Optional installed Scoop app selector. User mode registers the matching
        # Browsers entry with Windows and opens Default Apps when needed.
        # DefaultBrowser = 'global/librewolf'
    }

    Browsers = @{
        Zen = @{
            Enabled = $false
        }
        # LibreWolf = @{
        #     Enabled = $false
        #     # App = 'global/librewolf'
        #     # HostExecutableCandidates = @('D:\Apps\LibreWolf\librewolf.exe')
        # }
        # MyGeckoFork = @{
        #     Enabled = $true
        #     App = 'my-gecko-fork'
        #     BinName = 'my-browser'
        #     ProfilePath = 'profile'
        #     ProfileArgument = '-profile'
        #     ShellOnlyArguments = @('-no-remote')
        # }
    }

    Environment = @{
        # Override the portable PowerShell module roots. Relative paths are
        # resolved from CAPSULENV_ROOT; the first entry becomes
        # CAPSULENV_MODULE_ROOT and all entries are prepended to PSModulePath.
        # ModulePath = @('PowerShell\Modules')

        PathVariables = @{
            # CUSTOM_SDK_HOME = 'tool-data\custom-sdk'
        }
        Variables = @{
            # RUSTUP_TOOLCHAIN = 'stable'
        }
    }

    # ToolStorage.ProjectLinks replaces the default profile allow-list as one
    # unit when present. Other ToolStorage hashtables merge recursively.
    # PathVariables are directories, FileVariables are file paths whose parent
    # and an empty file are initialized inside CAPSULENV_ROOT when storage auto-init is enabled.
    # ToolStorage = @{
    #     Relocation = @{
    #         Uv = @{ App = 'global/my-uv'; BinName = 'uv' }
    #         Pixi = @{ App = 'my-pixi'; BinName = 'pixi' }
    #     }
    #     FileVariables = @{
    #         SCCACHE_CONF = 'tool-data\sccache\config.toml'
    #     }
    #     Variables = @{
    #         SCCACHE_CACHE_SIZE = '40G'
    #         RUSTC_WRAPPER = 'sccache'
    #     }
    #     ProjectLinks = @{
    #         'cargo-target' = @{
    #             Kind = 'Directory'
    #             ProjectPath = 'target'
    #             StorePath = 'project-cache\{ProjectId}\cargo-target'
    #             LinkType = 'Junction'
    #         }
    #     }
    # }

}

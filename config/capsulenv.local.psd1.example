@{
    # This file is merged over config/capsulenv.psd1.
    # Copy it to capsulenv.local.psd1; the local file is git-ignored.

    Scoop = @{
        # Root = 'D:\portable\scoop'
        # GlobalRoot = 'D:\portable\scoop-global'
        # RehydrateOnRelocation = $false

        # Only replay hooks that are safe and needed after relocation.
        # pre_install is deliberately not enabled by default because many
        # manifests treat it as a one-shot transformation.
        # ReplayHooks replaces the default allow-list as one unit.
        # Use @{} to disable automatic hook replay entirely.
        # ReplayHooks = @{
        #     firefox = @('post_install')
        #     'zen-browser' = @('post_install')
        # }


        # RelocationRepairs also replaces the default allow-list as one unit.
        # Use @{} to disable all persisted text path repairs.
        # RelocationRepairs = @{
        #     'some-app' = @(
        #         @{
        #             Path = 'config\settings.json'
        #             Format = 'json' # text | json
        #             Processes = @('some-app')
        #             MaxBytes = 4194304
        #             Required = $false
        #         }
        #     )
        # }
    }

    Bitwarden = @{
        StartOnEnter = $false
        # always | never | remember-until-lock
        Authorization = 'always'
    }

    Browsers = @{
        Zen = @{
            Enabled = $false
        }
    }

    Environment = @{
        PathVariables = @{
            # CUSTOM_SDK_HOME = 'tool-data\custom-sdk'
        }
        Variables = @{
            # RUSTUP_TOOLCHAIN = 'stable'
        }
    }

    # ToolStorage.ProjectLinks replaces the default profile allow-list as one
    # unit when present. Other ToolStorage hashtables merge recursively.
    # ToolStorage = @{
    #     Variables = @{
    #         SCCACHE_CACHE_SIZE = '40G'
    #         RUSTC_WRAPPER = 'sccache'
    #     }
    #     ProjectLinks = @{
    #         'cargo-target' = @{
    #             Kind = 'Directory'
    #             ProjectPath = 'target'
    #             StorePath = 'project-cache\{ProjectId}\cargo-target'
    #             LinkType = 'Junction'
    #         }
    #     }
    # }

}
